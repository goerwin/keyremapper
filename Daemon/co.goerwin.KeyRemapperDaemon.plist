<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>co.goerwin.KeyRemapperDaemon</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/KeyRemapperDaemon</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>co.goerwin.KeyRemapper</string>
	</array>
	<key>ProcessType</key>
	<string>Interactive</string>
	<!-- The daemon quits with the app, reopening it would wait for the default 10s to relaunch it -->
	<key>ThrottleInterval</key>
	<integer>1</integer>
	<key>MachServices</key>
	<dict>
		<key>co.goerwin.KeyRemapperDaemon</key>
		<true/>
	</dict>
</dict>
</plist>
