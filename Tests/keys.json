// A rule from several keys, with an action for all of them or one per key
{
  "rules": [
    {
      "from": ["H", "J", "K", "L"],
      "modifiers": ["Caps"],
      "to": ["LeftArrow", "DownArrow", "UpArrow", "RightArrow"]
    },
    { "from": ["A", "B"], "tap": ["X", "Y"], "hold": "Z" },
    { "from": ["Caps"] }
  ],
  "tests": [
    ["Caps:down H Caps:up", "LeftArrow"],
    ["Caps:down J:down K:down K:up J:up Caps:up", "DownArrow:down UpArrow:down UpArrow:up DownArrow:up"],
    ["Caps:down J:down Caps:up J:up", "DownArrow"],
    ["H", "H"],
    ["A", "X"],
    ["B", "Y"],
    ["B:down delay:400 B:up", "Z"]
  ]
}
