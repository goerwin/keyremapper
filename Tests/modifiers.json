// modifiers have to be held and other held modifiers have to be in optional
// (or optional has "any"). The keys sent by the modifiers are released while
// the rule's key is pressed
{
  "rules": [
    { "from": ["H"], "modifiers": ["CmdL"], "to": "LeftArrow" },
    { "from": ["J"], "modifiers": ["CmdL"], "optional": ["ShiftL"], "to": "DownArrow" },
    { "from": ["K"], "modifiers": ["CmdL"], "optional": ["any"], "to": "UpArrow" },
    { "from": ["L"], "modifiers": ["CmdL"], "to": "CmdL+ShiftL+L" },
    { "from": ["M"], "modifiers": ["F"], "to": "Enter" },
    { "from": ["N"], "to": "Y" },
    { "from": ["ShiftR"], "modifiers": ["ShiftL"], "to": "Caps" }
  ],
  "tests": [
    ["CmdL:down H CmdL:up", "CmdL:down CmdL:up LeftArrow CmdL:down CmdL:up"],
    ["CmdL:down H:down CmdL:up H:up", "CmdL:down CmdL:up LeftArrow"],
    ["H", "H"],
    ["CmdL:down ShiftL:down H ShiftL:up CmdL:up", "CmdL:down ShiftL:down H ShiftL:up CmdL:up"],

    ["CmdL:down ShiftL:down J ShiftL:up CmdL:up", "CmdL:down ShiftL:down CmdL:up DownArrow CmdL:down ShiftL:up CmdL:up"],
    ["CmdL:down AltL:down J AltL:up CmdL:up", "CmdL:down AltL:down J AltL:up CmdL:up"],
    ["CmdL:down AltL:down K AltL:up CmdL:up", "CmdL:down AltL:down CmdL:up UpArrow CmdL:down AltL:up CmdL:up"],
    // The held CmdL stays down instead of being released and pressed again
    ["CmdL:down L CmdL:up", "CmdL:down CmdL:up CmdL:down ShiftL:down L:down L:up ShiftL:up CmdL:up"],

    // Any key can be a modifier, only the real modifiers have to be listed.
    // Only the real modifiers are pressed again, F would type another F
    ["F:down M F:up", "F:down F:up Enter"],
    ["F:down M:down F:up M:up", "F:down F:up Enter:down Enter:up"],
    ["M", "M"],
    ["N", "Y"],
    ["F:down N F:up", "F:down Y F:up"],
    ["ShiftL:down N ShiftL:up", "ShiftL:down N ShiftL:up"],
    ["ShiftL:down ShiftR ShiftL:up", "ShiftL:down ShiftL:up Caps ShiftL:down ShiftL:up"]
  ]
}
