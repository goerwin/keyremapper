// hold: after holdDelay, if no key event came meanwhile. Its keys sent down are
// released with the key
{
  "holdDelay": 400,
  "rules": [
    { "keys": ["H"], "tap": "T", "hold": "W" },
    { "keys": ["M"], "hold": "CtrlL:down A" },
    { "keys": ["Mute"], "tap": "CtrlL+Tab", "hold": "CmdL:down ShiftL:down Tab" },
    { "keys": ["N"], "send": "N:down", "hold": "X" }
  ],
  "tests": [
    ["H", "T"],
    ["H:down delay:400 H:up", "W"],
    ["H:down delay:200 delay:200 H:up", "W"],
    ["H:down delay:399 H:up", ""],
    ["H:down delay:800 H:up", "W"],
    ["H:down A delay:400 H:up", "A"],
    ["A:down H:down A:up delay:400 H:up", "A"],
    ["H:down delay:400 H:up H", "W T"],
    ["M:down delay:400 M:up", "CtrlL:down A CtrlL:up"],
    ["Mute", "CtrlL+Tab"],
    ["Mute:down delay:400 Mute:up", "CmdL:down ShiftL:down Tab ShiftL:up CmdL:up"],
    ["N:down delay:400 N:up", "N:down X N:up"],
    ["Z:down delay:400 Z:up", "Z"],
    ["delay:400", ""]
  ]
}
