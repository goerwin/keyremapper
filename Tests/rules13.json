{
  "description": [
    "keyPresses of a keybinding",
    "they're added for each of its keys, with its if plus their own"
  ],
  "keybindings": [
    {
      "keys": ["A", "B"],
      "if": { "keyboard": "1" },
      "keyPresses": [
        { "send": "C" },
        { "ifHeldFor": 400, "send": "D" },
        { "ifPressedNTimes": 2, "if": { "Shift": true }, "send": "E" }
      ]
    }
  ],
  "tests": [
    ["keyboard:1 A", "C"],
    ["keyboard:1 B", "C"],
    ["keyboard:1 A:down test_hold A:up", "D"],
    ["keyboard:1 A A", "C C"],
    ["keyboard:1 Shift:down A A Shift:up", "Shift:down C E Shift:up"],
    ["A", "A"],
    ["A:down test_hold A:up", "A"]
  ]
}
