// A vim mode like the Karabiner one: F18 (Caps) + HJKL arrows, + F selects,
// + Alt clicks
{
  "rules": [
    { "from": ["F18"], "optional": ["any"], "tap": "Esc" },
    {
      "from": ["H", "J", "K", "L"],
      "modifiers": ["F18"],
      "optional": ["any"],
      "if": "vimShift",
      "to": ["ShiftL+LeftArrow", "ShiftL+DownArrow", "ShiftL+UpArrow", "ShiftL+RightArrow"]
    },
    {
      "from": ["H", "J", "K", "L"],
      "modifiers": ["F18"],
      "optional": ["any"],
      "to": ["LeftArrow", "DownArrow", "UpArrow", "RightArrow"]
    },
    {
      "from": ["F"],
      "modifiers": ["F18"],
      "optional": ["any"],
      "to": "set:vimShift",
      "afterKeyUp": "unset:vimShift"
    },
    { "from": ["AltL"], "optional": ["any"], "to": "AltL set:clickMode", "afterKeyUp": "unset:clickMode" },
    { "from": ["C"], "modifiers": ["F18"], "optional": ["any"], "if": "clickMode", "to": "AltL:up RightClick" },
    { "from": ["C"], "optional": ["any"], "if": "clickMode", "to": "AltL:up LeftClick" }
  ],
  "tests": [
    ["F18", "Esc"],
    ["F18:down H F18:up", "LeftArrow"],
    ["F18:down J:down F18:up J:up", "DownArrow"],
    ["F18:down F:down H F:up F18:up", "ShiftL:down LeftArrow:down LeftArrow:up ShiftL:up"],
    ["F18:down F:down F:up F18:up", ""],
    // F pressed before F18 types F and doesn't select
    ["F:down F18:down K F18:up F:up", "F:down UpArrow F:up"],
    // Releasing F18 leaves the mode, even with F held, until F18 is pressed
    // again
    ["F18:down F:down F18:up H F:up", "H"],
    ["F18:down F:down F18:up F18:down H F:up F18:up", "ShiftL:down LeftArrow:down LeftArrow:up ShiftL:up"],
    ["ShiftL:down F18:down H F18:up ShiftL:up", "ShiftL:down LeftArrow ShiftL:up"],
    ["ShiftL:down F18:down F:down H F:up F18:up ShiftL:up", "ShiftL:down ShiftL:down LeftArrow ShiftL:up"],
    ["CmdL:down F18:down L F18:up CmdL:up", "CmdL:down RightArrow CmdL:up"],
    ["F", "F"],
    ["AltL:down C AltL:up", "AltL:down AltL:up LeftClick"],
    ["AltL:down C:down AltL:up C:up", "AltL:down AltL:up LeftClick"],
    ["AltL:down F18:down C F18:up AltL:up", "AltL:down AltL:up RightClick"]
  ]
}
