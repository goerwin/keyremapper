// A vim mode like the Karabiner one: F18 (Caps) + HJKL arrows, + F selects,
// + Alt clicks
{
  "rules": [
    { "from": ["F18"], "optional": ["any"], "tap": "Esc" },
    {
      "from": ["H", "J", "K", "L"],
      "modifiers": ["F18", "F"],
      "optional": ["any"],
      "to": ["ShiftL+LeftArrow", "ShiftL+DownArrow", "ShiftL+UpArrow", "ShiftL+RightArrow"]
    },
    {
      "from": ["H", "J", "K", "L"],
      "modifiers": ["F18"],
      "optional": ["any"],
      "to": ["LeftArrow", "DownArrow", "UpArrow", "RightArrow"]
    },
    { "from": ["F"], "modifiers": ["F18"], "optional": ["any"] },
    { "from": ["C"], "modifiers": ["AltL", "F18"], "to": "RightClick" },
    { "from": ["C"], "modifiers": ["AltL"], "to": "LeftClick" }
  ],
  "tests": [
    ["F18", "Esc"],
    ["F18:down H F18:up", "LeftArrow"],
    ["F18:down J:down F18:up J:up", "DownArrow"],
    ["F18:down F:down H F:up F18:up", "ShiftL:down LeftArrow:down LeftArrow:up ShiftL:up"],
    ["F18:down F:down F:up F18:up", ""],
    // F pressed before F18 isn't typed again over the selection
    ["F:down F18:down K F18:up F:up", "F:down F:up ShiftL:down UpArrow:down UpArrow:up ShiftL:up"],
    ["ShiftL:down F18:down H F18:up ShiftL:up", "ShiftL:down LeftArrow ShiftL:up"],
    ["ShiftL:down F18:down F:down H F:up F18:up ShiftL:up", "ShiftL:down ShiftL:down LeftArrow ShiftL:up"],
    ["CmdL:down F18:down L F18:up CmdL:up", "CmdL:down RightArrow CmdL:up"],
    ["F", "F"],
    ["AltL:down C AltL:up", "AltL:down AltL:up LeftClick AltL:down AltL:up"],
    ["AltL:down C:down AltL:up C:up", "AltL:down AltL:up LeftClick"],
    ["AltL:down F18:down C F18:up AltL:up", "AltL:down AltL:up RightClick AltL:down AltL:up"]
  ]
}
