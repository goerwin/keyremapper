{
  "description": ["if with an array matches any of its values"],
  "remaps": [{ "from": "N", "to": "X", "if": { "keyboard": ["1", "2"] } }],
  "keybindings": [
    {
      "keys": ["D"],
      "if": { "appName": ["com.app1", "com.app2"], "Shift": false },
      "send": ["E:down", "E:up"]
    }
  ],
  "tests": [
    ["appName:com.app1 D", "E"],
    ["appName:com.app2 D", "E"],
    ["appName:com.app3 D", "D"],
    ["D", "D"],
    ["appName:com.app1 Shift:down D Shift:up", "Shift:down D Shift:up"],
    ["keyboard:2 N", "X"],
    ["keyboard:3 N", "N"]
  ]
}
